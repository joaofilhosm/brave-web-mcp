# Brave Search API key — https://api-dashboard.search.brave.com/
# Optional: DuckDuckGo is used automatically as fallback when Brave is unavailable.
BRAVE_API_KEY=

# Optional: default locale for searches (default: pt-br)
BRAVE_SEARCH_LANG=pt-br

# Optional: default country for searches (default: BR)
BRAVE_SEARCH_COUNTRY=BR

# Optional: comma-separated hostnames allowed to bypass the private-network guard
FETCH_ALLOW_PRIVATE_HOSTS=
